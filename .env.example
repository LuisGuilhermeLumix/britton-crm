# Copy to .env and fill in. Only VITE_* vars reach the browser bundle —
# never put the service_role key or the n8n secret here.
VITE_SUPABASE_URL=https://hbmocyetjsykqusvaevu.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only. Set with `supabase secrets set`, NOT in this file:
#   N8N_WEBHOOK_URL   the n8n production webhook that runs the pull
#   N8N_SECRET        value sent as the x-crm-key header
#   ALLOWED_ORIGIN    the CRM origin allowed through CORS (e.g. https://crm.example.com)
